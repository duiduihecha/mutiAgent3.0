          "description": "地震、火灾、洪水等突发灾害中的自救、互救与求助",
          "tasks": [
            {
              "id": "emergency_disaster_earthquake",
              "name": "地震应急避险",
              "pragmatic_intent": "在地震发生时选择正确的避险姿势和安全位置，理解“生命三角”概念，并在震动停止后安全撤离",
              "cultural_complexity": 2,
              "high_context": false,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈地震避险强调'趴下、掩护、抓住'（Drop, Cover, Hold on），中国强调就近避险和'生命三角'理论存在争议",
                "ja": "日语圈从幼儿园起就进行地震避险训练，日本经验强调躲在桌子下方而非寻找三角区",
                "ko": "韩语圈地震较少发生，民众避险意识相对薄弱，中国地震带居民有更丰富的避险经验",
                "es": "西班牙语圈（拉美）地震区居民有避险经验，但建筑结构不同导致最佳避险位置有差异",
                "ar": "阿拉伯语圈沙漠地区地震少，居民对地震了解有限，需特别学习建筑内避险知识",
                "ru": "俄语圈地震避险强调快速撤离到空旷处，中国城市高楼多，地震时不宜立即跑出",
                "fr": "法语圈地震避险培训较少，民众可能因不熟悉而做出危险行为（如跳楼）",
                "th": "东南亚文化圈海啸风险高，地震后需同时考虑海啸预警，中国沿海地区也需注意"
              }
            },
            {
              "id": "emergency_disaster_evacuate",
              "name": "火灾疏散逃生",
              "pragmatic_intent": "在火灾发生时正确使用湿毛巾捂住口鼻，沿疏散指示标志撤离，不乘坐电梯，必要时跳楼逃生",
              "cultural_complexity": 2,
              "high_context": false,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈高层建筑火灾强调使用消防楼梯，中国部分老旧建筑疏散指示标志不够清晰",
                "ja": "日语圈酒店房间配备缓降器等逃生设备，中国家庭很少配备此类设备",
                "ko": "韩语圈火灾时人们可能因顾及财物返回，中国消防宣传强调'小火快逃，浓烟关门'",
                "es": "西班牙语圈建筑消防规范与中文标识系统不同，需注意看懂中国消防标志",
                "ar": "阿拉伯语圈女性可能因服装不便影响逃生速度，中国公共场所建议穿着方便逃生的衣物",
                "ru": "俄语圈寒冷地区火灾时可能面临室内外温差问题，中国南方火灾中浓烟窒息是主要死因",
                "fr": "法语圈高层建筑有更多防火分隔设计，中国城中村和老旧小区防火条件较差",
                "th": "东南亚文化圈火灾时人们可能因不熟悉建筑结构而走错方向，需注意观察安全出口位置"
              }
            },
            {
              "id": "emergency_disaster_rescue",
              "name": "灾后求助与安置",
              "pragmatic_intent": "在灾后向救援人员说明被困情况，配合搜救行动，到达安置点后登记信息并领取物资",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈灾后人们习惯先联系家人报平安，中国灾后手机信号可能中断，需使用短信或微信",
                "ja": "日语圈灾后秩序井然，按指示排队领取物资，中国安置点可能出现哄抢物资的情况",
                "ko": "韩语圈灾后社区互助意识强，中国灾后安置以政府主导为主，民众需配合统一安排",
                "es": "西班牙语圈灾后人们习惯大声呼救，中国灾后救援强调保持体力、减少呼喊保存能量",
                "ar": "阿拉伯语圈灾后可能涉及宗教祈祷仪式，中国安置点需在尊重宗教习惯与公共秩序间平衡",
                "ru": "俄语圈灾后人们可能自行搭建临时住所，中国政府统一安置是主要方式",
                "fr": "法语圈灾后人们注重隐私和个人财产保护，中国安置点以集体生活为主，需适应共享空间",
                "th": "东南亚文化圈灾后人们可能先照顾老人小孩再顾自己，中国救援原则是'先救命后治伤'"
              }
            }
          ]
        }
      ]
    },
