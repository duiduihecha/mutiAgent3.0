{
  "_description": "三级语用任务图谱种子数据 — Domain → Scene → KnowledgePoint",
  "_version": "2.0",
  "_note": "餐饮美食(food)和职场办公(workplace)已完整填充。其余12个Domain仅保留骨架，请按需补充Scene和Task。",
  "domains": [
    {
      "id": "food",
      "name": "餐饮美食",
      "name_en": "Food & Dining",
      "icon": "🍜",
      "description": "点餐、买单、请客、餐桌礼仪",
      "scenes": [
        {
          "id": "ordering",
          "name": "点餐",
          "name_en": "Ordering",
          "icon": "📋",
          "description": "在餐厅点菜、询问菜品、表达口味偏好",
          "tasks": [
            {
              "id": "food_ordering_basic",
              "name": "基础点菜",
              "pragmatic_intent": "在中文餐厅中独立完成点菜，表达口味偏好并询问推荐",
              "cultural_complexity": 1,
              "high_context": false,
              "hsk_level": 1,
              "l1_conflict_points": {
                "en": "英语圈习惯逐道点菜（starter→main→dessert），而中文餐厅为合餐制共享点菜",
                "ja": "日语圈也使用合餐制，但点菜时常使用敬语，おまかせ与\"随便\"的文化差异显著",
                "ko": "韩语圈的点餐礼仪与中文类似（合餐），但반찬（小菜）文化与中国凉菜文化不同"
              }
            },
            {
              "id": "food_ordering_special",
              "name": "特殊饮食需求",
              "pragmatic_intent": "表达忌口、过敏、素食等特殊饮食需求，理解服务员对需求的处理方式",
              "cultural_complexity": 2,
              "high_context": false,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈直接声明过敏原（I am allergic to...），中文语境下需委婉表达以避免\"麻烦别人\"",
                "ar": "阿拉伯语圈清真饮食需求与中国清真餐饮体系可直接对应，但需注意地域差异"
              }
            },
            {
              "id": "food_ordering_recommend",
              "name": "请服务员推荐",
              "pragmatic_intent": "请服务员推荐招牌菜，理解\"招牌菜\"\"特色菜\"\"今日推荐\"的区别与回应方式",
              "cultural_complexity": 1,
              "high_context": false,
              "hsk_level": 1,
              "l1_conflict_points": {
                "en": "英语圈直接问\"What do you recommend?\"是常规操作，中文餐厅服务员的推荐可能受后厨备料或提成影响",
                "ja": "日语圈「おすすめは？」与中文\"推荐\"类似，但日本服务员的推荐更倾向于当日新鲜食材而非利润导向"
              }
            }
          ]
        },
        {
          "id": "treat",
          "name": "请客",
          "name_en": "Treating / Hosting",
          "icon": "🎉",
          "description": "请客吃饭、抢单、礼尚往来",
          "tasks": [
            {
              "id": "food_treat_pay",
              "name": "主动买单",
              "pragmatic_intent": "理解中国\"抢单\"文化的交际逻辑——买单不仅是付钱，更是人情关系的维系与宣告",
              "cultural_complexity": 4,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈习惯AA制（go Dutch），\"我请你\"是明确的邀请而非社交博弈",
                "ja": "日语圈有\"割り勘\"（AA）也有\"おごり\"（请客），但抢单的肢体动作（推拉）不如中文文化激烈",
                "ko": "韩语圈\"한턱내다\"（请客）文化深厚，长辈/上级默认买单，与中文抢单文化相近但有年龄等级差异",
                "es": "西班牙语圈\"invitar\"（邀请）通常意味着邀请者买单，不流行抢单"
              }
            },
            {
              "id": "food_treat_refuse",
              "name": "礼貌推辞",
              "pragmatic_intent": "掌握中国式的\"推拉\"话术——被邀请时先适度推辞以示谦逊，而非直接接受",
              "cultural_complexity": 5,
              "high_context": true,
              "hsk_level": 4,
              "l1_conflict_points": {
                "en": "英语圈直接接受邀请被视为礼貌（\"Yes, I'd love to!\"），推辞会被误解为真的不想去",
                "ja": "日语圈\"遠慮\"（客气）文化与之相近，但推辞的轮次和力度有差异",
                "fr": "法语圈社交中\"non merci\"明确拒绝是常态，反复推拉会被视为不真诚"
              }
            },
            {
              "id": "food_treat_invite",
              "name": "发出请客邀请",
              "pragmatic_intent": "用恰当的中文表达请客意图，区分\"我请客\"\"一起吃饭\"\"聚一聚\"的社交含义差异",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈\"Let's grab lunch\"通常默认各自付钱，中文\"一起吃个饭\"可能隐含请客意图",
                "ja": "日语圈「一緒に食事でも」不含请客默认，需明确说「ご馳走します」才表示请客"
              }
            }
          ]
        },
        {
          "id": "table_manners",
          "name": "餐桌礼仪",
          "name_en": "Table Manners",
          "icon": "🥢",
          "description": "筷子使用、座次安排、敬酒礼仪",
          "tasks": [
            {
              "id": "food_manners_chopsticks",
              "name": "筷子礼仪",
              "pragmatic_intent": "掌握筷子使用的基本禁忌（不插饭、不指人、不敲碗），理解其背后的文化象征",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈多用刀叉，筷子禁忌（如\"筷子插饭像上香\"）在西方无对应物",
                "ja": "日语圈筷子礼仪（箸使い）极为严格，部分禁忌比中国更多（如\"迷い箸\"）",
                "ko": "韩语圈使用金属筷子（扁平），与中国木筷手感不同，但禁忌类似"
              }
            },
            {
              "id": "food_manners_seating",
              "name": "座次安排",
              "pragmatic_intent": "理解中式宴请座次规则——主位、主宾位、副主宾位的安排逻辑及其社交含义",
              "cultural_complexity": 4,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈正式晚宴也有座次安排，但通常由女主人（hostess）安排且基于性别交替，中式的\"主位面门\"规则不同",
                "ja": "日语圈「上座・下座」概念与中式相似，但具体规则（如离门远近、是否有床の間）有差异",
                "ko": "韩语圈座次按年龄和职位严格排序，与中文\"以左为尊\"的传统不完全一致"
              }
            },
            {
              "id": "food_manners_toast",
              "name": "敬酒礼仪",
              "pragmatic_intent": "掌握敬酒的顺序、碰杯高度、祝酒词选择，理解\"干杯\"与\"随意\"的语境差异",
              "cultural_complexity": 4,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈\"cheers\"不涉及等级关系，中式敬酒须按职位/年龄顺序且杯沿低于对方",
                "ja": "日语圈「乾杯」礼仪与中文相似但杯沿高度规则不如中国严格，且倒酒时需为对方倒",
                "ru": "俄语圈敬酒（тост）文化深厚，每次碰杯后必须喝完，与中式\"随意\"形成对比"
              }
            }
          ]
        },
        {
          "id": "street_food",
          "name": "夜市小吃",
          "name_en": "Street Food & Night Markets",
          "icon": "🍢",
          "description": "夜市点餐、摊贩交流、小吃文化",
          "tasks": [
            {
              "id": "food_street_order",
              "name": "摊位点餐",
              "pragmatic_intent": "在夜市摊位用简洁中文快速点餐，包括询问价格、辣度、排队规则",
              "cultural_complexity": 1,
              "high_context": false,
              "hsk_level": 1,
              "l1_conflict_points": {
                "en": "英语圈夜市（night market）概念不普遍，对\"边走边吃\"和摊贩吆喝（\"来一串！\"）的文化语境陌生",
                "ja": "日语圈「屋台」文化与夜市相似，但点餐方式更安静有序，中国夜市的热闹叫卖可能让日本人感到压迫"
              }
            },
            {
              "id": "food_street_culture",
              "name": "小吃文化体验",
              "pragmatic_intent": "理解中国夜市小吃的社交属性——\"逛夜市\"不仅是吃饭更是社交休闲活动",
              "cultural_complexity": 2,
              "high_context": false,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈户外的\"food truck\"文化与夜市有交集但偏功能性，缺乏\"逛\"的休闲社交属性",
                "ko": "韩语圈「포장마차」（布帐马车）文化与中国夜市高度相似，都是社交+饮酒+小吃的复合场景"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "workplace",
      "name": "职场办公",
      "name_en": "Workplace & Office",
      "icon": "💼",
      "description": "会议、邮件、汇报、商务社交、面试",
      "scenes": [
        {
          "id": "meetings",
          "name": "工作会议",
          "name_en": "Work Meetings",
          "icon": "📊",
          "description": "参加/主持中文会议、发表意见、理解言外之意",
          "tasks": [
            {
              "id": "workplace_meeting_speak",
              "name": "会议发言",
              "pragmatic_intent": "在中国职场会议中用恰当方式表达观点，平衡\"直言不讳\"与\"给面子\"的张力",
              "cultural_complexity": 4,
              "high_context": true,
              "hsk_level": 4,
              "l1_conflict_points": {
                "en": "英语圈会议鼓励直接表达不同意见（\"I disagree because...\"），中文会议中公开反对上级意见可能被视为挑战权威",
                "ja": "日语圈会议（会議）的发言顺序和敬语层级比中国更严格，但\"委婉否定\"的模式相似",
                "de": "德语圈职场以直接沟通著称（\"Klartext\"），对中国会议的含蓄表达容易误读为\"没意见\"或\"不专业\""
              }
            },
            {
              "id": "workplace_meeting_agree",
              "name": "表达同意与附和",
              "pragmatic_intent": "掌握\"对\"\"是\"\"好的\"\"嗯嗯\"在中国会议中的不同含义——它们可能表示\"听到了\"而非\"我同意\"",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈\"yes\"通常表示同意，中文会议中的\"是\"\"对\"可能只是表示礼貌性倾听，不代表真正同意",
                "ja": "日语圈「はい」同樣有\"听到了\"的含义，与中文\"是\"的歧义相似，但日本人更倾向于用「そうですね」表达模糊同意"
              }
            },
            {
              "id": "workplace_meeting_minutes",
              "name": "理解会议纪要",
              "pragmatic_intent": "阅读中国式会议纪要，识别其中的委婉措辞——\"原则上同意\"\"进一步研究\"\"建议考虑\"的真实含义",
              "cultural_complexity": 4,
              "high_context": true,
              "hsk_level": 5,
              "l1_conflict_points": {
                "en": "英语圈会议纪要（minutes）追求明确性和可执行性，中文会议纪要保持模糊性以留出协商空间，\"原则上同意\"≈\"不同意\"",
                "ja": "日语圈「議事録」也有类似委婉表达（如\"検討する\"≈暂不推进），但\"持ち帰り\"更为常见"
              }
            }
          ]
        },
        {
          "id": "emails",
          "name": "邮件与书面沟通",
          "name_en": "Email & Written Communication",
          "icon": "📧",
          "description": "撰写中文商务邮件、微信工作沟通、正式函件",
          "tasks": [
            {
              "id": "workplace_email_formal",
              "name": "正式邮件写作",
              "pragmatic_intent": "撰写符合中国职场规范的正式邮件，包括称呼、敬语、落款的层级选择",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 4,
              "l1_conflict_points": {
                "en": "英语圈商务邮件以简洁为佳（\"Just a quick note...\"），中文邮件倾向于完整礼貌框架（\"尊敬的...您好...此致敬礼\"），省略敬语被视为不礼貌",
                "ja": "日语圈商务邮件（ビジネスメール）敬语层级极其复杂，中文的\"尊敬的\"\"此致敬礼\"相对简洁但仍需注意称谓"
              }
            },
            {
              "id": "workplace_wechat_work",
              "name": "微信工作沟通",
              "pragmatic_intent": "在中国职场中使用微信进行工作沟通，理解加好友礼仪、群聊规矩、语音消息的使用边界",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈职场沟通以邮件/Slack为主，使用个人微信（WeChat）进行工作沟通在中国是常态，但边界模糊可能导致隐私担忧",
                "ko": "韩语圈职场也用KakaoTalk进行工作沟通，与微信工作群类似，但\"已读不回\"在两种文化中含义不同"
              }
            },
            {
              "id": "workplace_email_pushback",
              "name": "书面推辞与拒绝",
              "pragmatic_intent": "用中文书面语婉拒工作请求，理解\"不太方便\"\"有点困难\"\"再考虑考虑\"的实际拒绝力度",
              "cultural_complexity": 4,
              "high_context": true,
              "hsk_level": 5,
              "l1_conflict_points": {
                "en": "英语圈书面拒绝倾向于明确但礼貌（\"Unfortunately, we are unable to...\"），中文的\"不太方便\"是一个高度模糊的拒绝信号，英语母语者容易误解为\"还有协商空间\"",
                "ja": "日语圈「難しい」「検討します」同样是间接拒绝，与中文\"有点困难\"相似，但日本人更能准确解码这种信号"
              }
            }
          ]
        },
        {
          "id": "hierarchy",
          "name": "职场层级与关系",
          "name_en": "Workplace Hierarchy & Guanxi",
          "icon": "🏢",
          "description": "与上级/同事/下属的相处之道、称呼、送礼",
          "tasks": [
            {
              "id": "workplace_hierarchy_title",
              "name": "职场称呼",
              "pragmatic_intent": "选择恰当的职场称呼——\"总\"\"哥\"\"姐\"\"老师\"的使用场景与误用风险",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈职场以first name为基础，中文职场中直呼其名（即使是全名）可能被视为不尊重，\"X总\"\"X哥\"\"X姐\"的层级化称呼在西方无对应物",
                "ja": "日语圈职场称呼以\"さん\"\"部長\"\"課長\"等职务名称为主，与中国\"X总\"类似但体系不同",
                "ko": "韩语圈职场称呼（직함）极其严格，\"님\"\"사장님\"等与中文称呼有结构相似性"
              }
            },
            {
              "id": "workplace_hierarchy_face",
              "name": "维护面子与给台阶",
              "pragmatic_intent": "理解职场中的\"给面子\"\"给台阶下\"——如何在不伤对方面子的前提下提出异议或纠正错误",
              "cultural_complexity": 5,
              "high_context": true,
              "hsk_level": 5,
              "l1_conflict_points": {
                "en": "英语圈职场文化中\"constructive feedback\"通常当面直接给出，中国的\"给面子\"要求在公开场合维护他人尊严、私下再提意见，直接当众指出错误是严重冒犯",
                "ja": "日语圈「建前・本音」（场面话与真心话）的区分与中文\"面子\"文化同源但表达方式不同",
                "ar": "阿拉伯语圈同样有强烈的\"面子\"（ماء الوجه）文化，与中国相似但基于部落/家族荣誉而非职场层级"
              }
            },
            {
              "id": "workplace_hierarchy_gift",
              "name": "职场送礼文化",
              "pragmatic_intent": "理解中国职场中送礼的时机、金额、收受礼仪，区分\"人情往来\"与\"贿赂\"的文化边界",
              "cultural_complexity": 5,
              "high_context": true,
              "hsk_level": 4,
              "l1_conflict_points": {
                "en": "英语圈企业通常有严格的反贿赂合规政策（anti-bribery compliance），任何形式的礼物都可能触发合规审查，与中国\"人情往来\"形成根本冲突",
                "ja": "日语圈「お中元」「お歳暮」是制度化送礼时段，中国职场送礼更柔性但没有固定时间段",
                "ko": "韩语圈职场送礼在명절（节日）期间集中发生，与中国春节送礼相似"
              }
            }
          ]
        },
        {
          "id": "interviews",
          "name": "面试与求职",
          "name_en": "Job Interviews",
          "icon": "🤝",
          "description": "参加中文面试、谈薪资、理解雇佣文化",
          "tasks": [
            {
              "id": "workplace_interview_self",
              "name": "自我介绍策略",
              "pragmatic_intent": "在中国面试中进行恰当的自我介绍——平衡自信与谦虚，理解\"你有什么缺点\"的文化回答模式",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 4,
              "l1_conflict_points": {
                "en": "英语圈面试鼓励展示个人成就（\"I led a team of 10...\"），中文面试中过度自我推销会被视为\"不踏实\"，需用\"我们团队\"而非\"我\"来叙述成就",
                "ja": "日语圈面试（面接）的谦逊程度更高，中国面试的\"适度自信\"在日本人看来可能已经过分自信"
              }
            },
            {
              "id": "workplace_interview_salary",
              "name": "谈薪资期望",
              "pragmatic_intent": "在中国职场面试中谈薪资，理解\"薪资面议\"\"根据能力定薪\"\"市场水平\"的实际含义与谈判策略",
              "cultural_complexity": 3,
              "high_context": false,
              "hsk_level": 4,
              "l1_conflict_points": {
                "en": "英语圈薪资谈判是标准流程，直接报出期望数字被视为专业，中文面试中的含蓄谈薪资方式（\"看重发展机会\"）容易被误解为对薪资不关心",
                "ja": "日语圈新卒采用薪资通常不可协商，中途采用才涉及谈判，中国互联网行业薪资谈判的空间比日本大"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "daily",
      "name": "日常社交",
      "name_en": "Daily Social",
      "icon": "👋",
      "description": "问候、寒暄、自我介绍、告别",
      "scenes": [
        {
          "id": "greeting",
          "name": "寒暄问候",
          "name_en": "Greetings & Small Talk",
          "icon": "👋",
          "description": "日常见面问候、寒暄回应与告别用语",
          "tasks": [
            {
              "id": "daily_greet_basic",
              "name": "基础问候",
              "pragmatic_intent": "用恰当的问候语与他人打招呼，如“你好”“早上好”“好久不见”等",
              "cultural_complexity": 1,
              "high_context": false,
              "hsk_level": 1,
              "l1_conflict_points": {
                "en": "英语圈'Hello/Hi'是平等问候，中文'吃了吗''去哪儿'是寒暄而非真正询问吃饭情况",
                "ja": "日语圈用敬语寒暄，'お元気ですか'与中文'你好'功能相似但礼貌层级不同",
                "ko": "韩语圈'밥 먹었어요?'与中文'吃了吗'类似，都可作为寒暄但对外国人可能造成误解",
                "es": "西班牙语圈'¿Cómo estás?'是平等问候，中文寒暄需考虑年龄和熟悉度差异",
                "ar": "阿拉伯语圈问候注重宗教祝福（السلام عليكم），与中文寒暄的话题选择不同",
                "ru": "俄语圈直接问候'Привет/Здравствуйте'，中文'吃了吗'对外国人可能造成困惑",
                "fr": "法语圈'Bonjour'是标准问候，中文寒暄需要理解其社交润滑剂功能",
                "th": "东南亚文化圈用'สวัสดีครับ/ค่ะ'配合合十礼，中文问候不涉及身体语言规范"
              }
            },
            {
              "id": "daily_greet_response",
              "name": "寒暄式回应",
              "pragmatic_intent": "理解并回应'吃了吗''去哪儿''最近忙吗'等寒暄式问候",
              "cultural_complexity": 2,
              "high_context": true,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈对'How are you?'回答'Fine'是标准模式，中文'吃了吗'不需要真实回答吃饭状态",
                "ja": "日语圈对寒暄有固定回应模式'食べましたか？→はい、食べました'，中文寒暄回应更灵活",
                "ko": "韩语圈寒暄回应时用'네/아니요'，中文寒暄回应需要根据语境判断是否需要详细说明",
                "es": "西班牙语圈对寒暄倾向于热情回应，中文寒暄回应通常简短以保持适当距离感",
                "ar": "阿拉伯语圈寒暄回应常带宗教祝福，中文寒暄回应不需要引入宗教元素",
                "ru": "俄语圈寒暄回应相对简短直接，中文寒暄回应有时需要'客气'一下",
                "fr": "法语圈寒暄回应讲究礼仪，中文寒暄回应过于热情可能显得不自然",
                "th": "东南亚文化圈寒暄回应时保持微笑，中文回应时微笑不是强制要求"
              }
            },
            {
              "id": "daily_greet_farewell",
              "name": "告别用语",
              "pragmatic_intent": "根据关系和场合选择恰当的告别语，如'再见''慢走''下次再聊'",
              "cultural_complexity": 1,
              "high_context": false,
              "hsk_level": 1,
              "l1_conflict_points": {
                "en": "英语圈'Goodbye/Bye'是标准告别，中文'慢走''常来'包含关心含义但字面意义可能造成困惑",
                "ja": "日语圈'さようなら'用于正式长期告别，日常用'またね/失礼します'与中文告别语对应",
                "ko": "韩语圈'안녕히 가세요/안녕히 계세요'区分离开和留下，中文'慢走'没有这种区分",
                "es": "西班牙语圈'¡Adiós!/¡Hasta luego!'可带亲吻礼，中文告别时身体接触较少",
                "ar": "阿拉伯语圈告别常说'مع السلامة'并触摸胸口，中文告别没有此类身体语言",
                "ru": "俄语圈'До свидания/Пока'是标准告别，中文'保重''多联系'体现关系亲疏",
                "fr": "法语圈'Au revoir'配合轻微握手或亲吻礼，中文告别时握手不是必须",
                "th": "东南亚文化圈告别时行合十礼并说'ขอบคุณครับ/ค่ะ'，中文告别不需要双手合十"
              }
            }
          ]
        },
        {
          "id": "introduction",
          "name": "自我介绍",
          "name_en": "Self Introduction",
          "icon": "🪪",
          "description": "初次见面时的自我介绍与他人介绍",
          "tasks": [
            {
              "id": "daily_intro_self",
              "name": "基础自我介绍",
              "pragmatic_intent": "在初次见面时介绍自己的姓名、国籍、工作或学习情况",
              "cultural_complexity": 1,
              "high_context": false,
              "hsk_level": 1,
              "l1_conflict_points": {
                "en": "英语圈自我介绍可从名字开始，中文通常先说全名再补充信息，顺序略有不同",
                "ja": "日语圈自我介绍强调所属（公司/学校）和职位，与中文自我介绍侧重点不同",
                "ko": "韩语圈自我介绍与中文类似，但更重视年龄顺序和敬语使用",
                "es": "西班牙语圈自我介绍较为热情开放，会主动握手或亲吻脸颊",
                "ar": "阿拉伯语圈自我介绍有时会提及家族背景，中文自我介绍通常不涉及家族",
                "ru": "俄语圈自我介绍相对简洁直接，中文自我介绍可能包含更多客套话",
                "fr": "法语圈自我介绍使用'Je m'appelle...'格式，中文'我叫...'结构不同",
                "th": "东南亚文化圈自我介绍时会双手合十并轻微鞠躬，中文自我介绍不需要此礼仪"
              }
            },
            {
              "id": "daily_intro_others",
              "name": "介绍他人",
              "pragmatic_intent": "在社交场合将朋友或同事介绍给其他人，注意介绍的先后顺序和措辞",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈介绍时说双方姓名加一句简单介绍即可，中文介绍需要考虑年龄、职位等因素决定先后顺序",
                "ja": "日语圈介绍时遵循'位下→位上'原则，先介绍位低者给位高者，这与中文介绍顺序类似",
                "ko": "韩语圈介绍礼仪与中文相似，强调年龄和身份决定介绍顺序",
                "es": "西班牙语圈介绍时通常提及双方共同点或兴趣，中文介绍较少涉及此类信息",
                "ar": "阿拉伯语圈介绍时注意性别因素，男女分开介绍是常见做法",
                "ru": "俄语圈介绍相对直接，不特别强调等级顺序",
                "fr": "法语圈介绍时使用敬称（ Monsieur/Mademoiselle），中文'先生/女士'使用频率较低",
                "th": "东南亚文化圈介绍时保持微笑和谦逊态度，中文介绍时表情管理要求较低"
              }
            },
            {
              "id": "daily_intro_inquiry",
              "name": "询问对方信息",
              "pragmatic_intent": "礼貌地询问对方的职业、籍贯、兴趣爱好等信息以延续对话",
              "cultural_complexity": 2,
              "high_context": false,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈询问职业'What do you do?'是常见话题，中文询问收入'你工资多少'是严重冒犯",
                "ja": "日语圈询问前需考虑关系亲疏，用'お仕事は...'等敬语形式表达",
                "ko": "韩语圈询问年龄以确定称呼（존댓말/반말），中文询问年龄对成年人也需谨慎",
                "es": "西班牙语圈询问家庭情况（¿Tienes hermanos?）是拉近关系的方式，中文询问家庭需注意场合",
                "ar": "阿拉伯语圈询问婚姻状况和子女是常见话题，中文对陌生人询问婚姻可能引起不适",
                "ru": "俄语圈询问相对直接，'Где вы работаете?'是正常问题",
                "fr": "法语圈询问职业是社交礼仪的一部分，中文询问需要更委婉的表达方式",
                "th": "东南亚文化圈询问对方籍贯以寻找共同话题，中文询问籍贯有时带有地域刻板印象风险"
              }
            }
          ]
        },
        {
          "id": "invitation",
          "name": "邀约与拒绝",
          "name_en": "Invitation & Declination",
          "icon": "🤝",
          "description": "发出邀请、接受邀约和委婉拒绝的语用策略",
          "tasks": [
            {
              "id": "daily_invt_offer",
              "name": "发出邀约",
              "pragmatic_intent": "根据关系亲疏选择合适的邀约方式，如'要不要一起吃饭''有时间吗'",
              "cultural_complexity": 2,
              "high_context": true,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈邀约相对直接'Would you like to...?'，中文邀约长辈或上级时需要铺垫和试探",
                "ja": "日语圈邀约需使用敬语'ご一緒していただけますか'，中文'一起吃饭吧'更口语化",
                "ko": "韩语圈邀约时考虑年龄因素，对年长者使用敬语邀约'시간 되시면 같이 식사 어때요?'",
                "es": "西班牙语圈邀约较为热情'¿Te gustaría...?¡Vamos!'，中文邀约语气相对温和",
                "ar": "阿拉伯语圈邀约时可能重复多次表示诚意，中文邀约重复可能显得过于热情",
                "ru": "俄语圈邀约相对直接'Пойдем в...?'，中文邀约时需要考虑对方是否有时间",
                "fr": "法语圈邀约使用'Voulez-vous...'等正式表达，中文邀约根据场合选择正式或随意语气",
                "th": "东南亚文化圈邀约时可能用微笑和眼神确认，中文邀约时对方沉默不等于拒绝"
              }
            },
            {
              "id": "daily_invt_accept",
              "name": "接受邀约",
              "pragmatic_intent": "愉快地接受邀约并表达感谢，如'好啊''太好了''谢谢邀请'",
              "cultural_complexity": 1,
              "high_context": false,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈接受邀约说'Sounds great!'即可，中文接受邀约后可能需要询问时间地点细节",
                "ja": "日语圈接受邀约时表达感谢'是非お願いします'，中文'谢谢'使用频率较低",
                "ko": "韩语圈接受邀约时用'네, 좋아요'并表示感谢，中文接受时表达热情程度可更高",
                "es": "西班牙语圈接受邀约非常热情'Sí, por supuesto!'，中文表达相对含蓄",
                "ar": "阿拉伯语圈接受邀约时表达感谢和赞美，中文接受后不需要额外的宗教祝福",
                "ru": "俄语圈接受邀约直接'Да, пойдем'，中文接受后可能需要表达期待",
                "fr": "法语圈接受邀约时使用礼貌用语'Avec plaisir'，中文'好啊'没有对应礼仪含义",
                "th": "东南亚文化圈接受邀约时可能略显犹豫以示谦虚，中文直接接受'好啊'是正常反应"
              }
            },
            {
              "id": "daily_invt_decline",
              "name": "委婉拒绝",
              "pragmatic_intent": "在不伤和气的前提下拒绝邀约，使用'下次吧''今天不太方便'等策略",
              "cultural_complexity": 4,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈拒绝邀约相对直接'Sorry, I'm busy'，中文拒绝需要更委婉以免伤对方面子",
                "ja": "日语圈拒绝邀约使用'ちょっと...'等暧昧表达和謝罪，中文拒绝时'下次吧'是常见策略",
                "ko": "韩语圈拒绝邀约时表达遗憾'아쉽게도...'，中文拒绝后可能需要提供替代方案",
                "es": "西班牙语圈拒绝邀约可能被认为不礼貌，中文拒绝邀约后关系可能受影响",
                "ar": "阿拉伯语圈拒绝邀约需要非常委婉并多次表达歉意，中文拒绝时不需要如此复杂的流程",
                "ru": "俄语圈拒绝邀约相对直接'Не могу'，中文直接拒绝可能显得冷漠",
                "fr": "法语圈拒绝邀约表达歉意'Je suis désolé(e)'，中文拒绝时不需要反复道歉",
                "th": "东南亚文化圈拒绝邀约时微笑并说'ไม่สะดวกครับ/ค่ะ'，中文拒绝时微笑可能被误解为同意"
              }
            }
          ]
        },
        {
          "id": "small_talk",
          "name": "闲聊话题",
          "name_en": "Small Talk Topics",
          "icon": "💬",
          "description": "选择安全话题、延续对话和处理敏感话题",
          "tasks": [
            {
              "id": "daily_st_topic",
              "name": "安全话题选择",
              "pragmatic_intent": "选择天气、美食、旅游等安全话题开启闲聊，避免触及隐私或敏感话题",
              "cultural_complexity": 2,
              "high_context": false,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈天气、工作是安全话题，中文闲聊需避免问收入、年龄、婚姻状况等隐私",
                "ja": "日语圈闲聊话题与中文类似，但'天気'使用频率更高，日本职场不讨论下班后私人活动",
                "ko": "韩语圈闲聊时常问'밥 먹었어요?'（吃饭了吗），中文'吃了吗'也可作为闲聊话题",
                "es": "西班牙语圈聊足球、家庭是常见话题，中文与陌生人聊政治需谨慎",
                "ar": "阿拉伯语圈聊家庭、子女是拉近关系的方式，中文询问家庭可能涉及隐私边界",
                "ru": "俄语圈闲聊话题相对直接，政治和历史是常见话题，中文闲聊时这些话题需谨慎",
                "fr": "法语圈聊美食、艺术是安全话题，中文闲聊时'吃了没'比法国人更常用",
                "th": "东南亚文化圈聊食物、天气是安全话题，中文闲聊时谈论他人外貌需谨慎"
              }
            },
            {
              "id": "daily_st_extend",
              "name": "话题延续技巧",
              "pragmatic_intent": "使用'是吗''然后呢''真的吗'等回应技巧延续对话，表达倾听和关注",
              "cultural_complexity": 3,
              "high_context": true,
              "hsk_level": 3,
              "l1_conflict_points": {
                "en": "英语圈用'Tell me more'等直接表达，中文用'是吗''真的吗''然后呢'等间接方式表示关注",
                "ja": "日语圈用'そうなんですか''へえ''なるほど'等附和语，中文的'嗯''是啊'功能类似",
                "ko": "韩语圈用'네, 그리고...'延续话题，中文'然后'的使用频率高于韩语",
                "es": "西班牙语圈用'¿Ah sí?'延续话题，中文'是吗'的语气比西班牙语更中性",
                "ar": "阿拉伯语圈用'نعم؟'（是吗？）延续话题，中文'是吗'有时表示怀疑",
                "ru": "俄语圈用'Правда?'延续话题，中文'真的假的'语气更口语化",
                "fr": "法语圈用'Vraiment?'延续话题，中文'真的假的'有时带有调侃意味",
                "th": "东南亚文化圈用微笑和'อืม'延续话题，中文回应时沉默可能被误解为不感兴趣"
              }
            },
            {
              "id": "daily_st_sensitive",
              "name": "敏感话题处理",
              "pragmatic_intent": "识别并巧妙回避政治、宗教、收入等敏感话题，或在无意中触及后及时转移话题",
              "cultural_complexity": 4,
              "high_context": true,
              "hsk_level": 4,
              "l1_conflict_points": {
                "en": "英语圈可以讨论政治、宗教等话题并保持礼貌，中文闲聊时需谨慎处理此类话题",
                "ja": "日语圈闲聊时避免政治话题是基本原则，'空気を読む'要求避开敏感话题",
                "ko": "韩语圈政治话题讨论需注意场合，中文闲聊时政治话题比日本更敏感",
                "es": "西班牙语圈聊足球时可能涉及地区冲突，中文闲聊时地域歧视话题需避免",
                "ar": "阿拉伯语圈宗教话题敏感度极高，中文闲聊时涉及宗教需极其谨慎",
                "ru": "俄语圈对苏联历史评价是敏感话题，中文闲聊时文革等话题需避免",
                "fr": "法语圈聊黄背心运动等社会话题是正常的，中文闲聊时社会事件讨论需谨慎",
                "th": "东南亚文化圈聊王室需极其谨慎，中文闲聊时涉及领导人的话题是绝对禁区"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "campus",
      "name": "校园生活",
      "name_en": "Campus Life",
      "icon": "🎓",
      "description": "选课、课堂互动、社团活动、考试",
      "scenes": [
        {
          "id": "classroom",
          "name": "课堂互动",
          "name_en": "Classroom Interaction",
          "icon": "📚",
          "description": "课堂提问、回答问题、请假说明、参与讨论",
          "tasks": [
            {
              "id": "campus_classroom_question",
              "name": "课堂提问",
              "pragmatic_intent": "在课堂上举手提问或用礼貌方式打断老师，表达没听懂或需要进一步解释",
              "cultural_complexity": 1,
              "high_context": false,
              "hsk_level": 2,
              "l1_conflict_points": {
                "en": "英语圈课堂上直接提问（Hand up + What's ...?）是鼓励行为，中文课堂需先说\"老师，我可以问一下吗？\"等缓冲语",
                "ja": "日语圈课堂提问使用「すみません、～」等缓冲语，与中文类似但日本学生更倾向于课后单独询问",
                "ko": "韩语圈课堂提问同样需要先举手获得许可，但常用「선생님,」开头",
                "es": "西班牙语圈学生提问更直接（¿Puedo preguntar...?），中文课堂的\"缓冲语\"可能被视为啰嗦",
                "ar": "阿拉伯语圈课堂上学生发言需先说「بسم الله」或赞美语，直接提问可能显得冒失",
                "ru": "俄语圈课堂上提问相对直接，中文课堂的\"老师，请问\"结构需要时间适应",
                "fr": "法语圈学生常用「Monsieur/Madame,」开头，与中文课堂礼仪相似",
                "th": "东南亚学生提问前常有微笑或轻微鞠躬动作，与中文课堂的举手示意类似"
              }
            },
            {
              "id": "campus_classroom_leave",
              "name": "课堂请假",
              "pragmatic_intent": "向老师说明需要早退或请假的原因，使用恰当的请假理由与表达方式",
