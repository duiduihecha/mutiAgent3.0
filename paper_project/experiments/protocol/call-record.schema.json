{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "call-record.schema.json",
  "title": "Experiment Call Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["call_id", "run_id", "base_case_id", "condition", "category", "label", "provider", "model", "messages_sha256", "knowledge_sha256", "generation_profile", "model_routing_sha256", "config_sha256", "temperature", "max_tokens", "started_at", "ended_at", "latency_ms", "usage", "cost_cny", "status", "error"],
  "properties": {
    "call_id": {"type": "string"},
    "run_id": {"type": "string"},
    "base_case_id": {"type": "string"},
    "condition": {"type": "string"},
    "category": {"enum": ["generation", "guardrail", "judge", "local"]},
    "label": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "messages_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "knowledge_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "generation_profile": {"type": ["string", "null"], "enum": ["daily", "quality", null]},
    "model_routing_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temperature": {"type": ["number", "null"]},
    "max_tokens": {"type": ["integer", "null"], "minimum": 0},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "latency_ms": {"type": "integer", "minimum": 0},
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens", "estimated"],
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "estimated": {"type": "boolean"}
      }
    },
    "cost_cny": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["success", "failed"]},
    "error": {"type": ["object", "string", "null"]},
    "retry_of": {"type": ["string", "null"]}
  }
}
