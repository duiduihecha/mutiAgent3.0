{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "hnd1"
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "app/api/learning/**/*.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "buildCommand": "pnpm install --frozen-lockfile && pnpm next build"
}