{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm install --prefer-frozen-lockfile --prefer-offline && pnpm next build",
  "installCommand": "pnpm install --prefer-frozen-lockfile",
  "outputDirectory": ".next",
  "regions": [
    "hnd1"
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "app/api/learning/**/*.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!docs' ':!scripts'"
}